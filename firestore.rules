rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    // Perfil de usuario: cada quien lee/edita el suyo (sin poder auto-otorgarse
    // el rol de administrador); los administradores pueden ver y gestionar a todos.
    match /usuarios/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.rol == 'turista';
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && request.resource.data.rol == resource.data.rol) || isAdmin()
      );
      allow delete: if isAdmin();

      // Favoritos: privados, solo el dueño de la cuenta los lee/escribe.
      match /favoritos/{favId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Catálogo (lugares, hosterías, emprendimientos, rutas): lectura pública,
    // escritura solo para administradores. Cada colección se declara aparte
    // porque las reglas de Firestore no soportan filtros "where" en match.
    match /lugares/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /comentarios/{comentarioId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /calificaciones/{uidCalificacion} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == uidCalificacion;
      }
    }

    match /hosterias/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /comentarios/{comentarioId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /calificaciones/{uidCalificacion} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == uidCalificacion;
      }
    }

    match /emprendimientos/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /comentarios/{comentarioId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /calificaciones/{uidCalificacion} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == uidCalificacion;
      }
    }

    match /rutas/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
