rules_version = '2';

// Las fotos de usuarios (comentarios, formularios de admin) se siguen
// comprimiendo y guardando como data URI base64 directamente en Firestore
// (ver lib/core/utils/image_utils.dart). Storage solo aloja las fotos del
// catálogo oficial (assets/images -> catalogo/), subidas por el equipo: lectura
// pública para que la app las consuma, escritura solo para administradores.
service firebase.storage {
  match /b/{bucket}/o {
    match /catalogo/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
